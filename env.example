# Base de datos (SQLite local, no requiere servidor externo)
DATABASE_URL="file:./dev.db"

# Servidor
PORT=4000

# JWT
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="7d"

# Proveedor de pagos activo para depositos: MOCK | MERCADOPAGO
PAYMENT_PROVIDER=MOCK

# Credenciales de MercadoPago (modo sandbox). Solo necesarias si PAYMENT_PROVIDER=MERCADOPAGO
# Se obtienen en https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# URL publica donde MercadoPago pueda enviar el webhook de confirmacion (ej. via ngrok)
MERCADOPAGO_WEBHOOK_URL=""

# URL base del frontend (para links de checkout y redirecciones)
FRONTEND_URL="http://localhost:5173"
